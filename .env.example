# Copy this file to .env and replace every placeholder before running
#   docker compose up -d --build
# Never commit the real .env file.
# Generate strong random values, e.g.:  openssl rand -base64 48

# --- PostgreSQL (users) ---
POSTGRES_USER=jornada
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=usuariosdb

# --- MongoDB (work shifts) ---
# Root account, used only by the MongoDB container itself.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo-root-password
MONGO_DB=jornada_laboral
# Least-privilege account (readWrite on MONGO_DB) used by the backend.
# Created by mongo-init/init-mongo.js on the first start of an empty volume.
MONGO_APP_USER=jornada_app
MONGO_APP_PASSWORD=change-me-mongo-app-password

# --- Backend ---
# HS256 signing key; must be at least 32 characters or the backend refuses to start.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Demo admin, created at backend startup only if no admin exists yet.
# The password must be at least 12 characters; it is stored as a bcrypt hash.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me-demo-admin-password

# --- Frontend ---
# Baked into the public JavaScript bundle at build time: VITE_* values are visible to
# anyone, so never put a secret in a VITE_* variable.
VITE_API_URL=http://localhost:5000/api
# Origin of VITE_API_URL, allowed by the Content-Security-Policy served by nginx.
API_ORIGIN=http://localhost:5000
